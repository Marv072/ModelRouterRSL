# Copy to .env; never commit real keys.
ROUTER_RUNTIME_MODE=internal
ROUTER_ENABLE_STANDALONE_KEYS=false
ROUTER_ENABLE_ADMIN_API=true
ROUTER_ENABLE_USAGE_API=true
ROUTER_INTERNAL_API_KEY=replace-with-local-runtime-secret
ADMIN_API_KEY=replace-with-local-admin-secret
ROUTER_DB=router.db
RSL_DB=router.rsl.db
ROUTER_CONFIG=config/providers.yaml
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_KEY_1=replace-with-upstream-key
AUTO_SYNC_PROVIDER_MODELS=false
ROUTER_PROVIDER_TIMEOUT=60
ROUTER_MIN_PROVIDER_RETRIES=1
