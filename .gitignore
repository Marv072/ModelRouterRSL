logs/
*.log
*.log.*

# Local working documents; README is the published documentation.
docs/
README.upstream.md
ATTRIBUTION.md
artifacts/**/REPORT.md

# Local packaging and one-off connectivity helpers.
/scripts/package_submission.py
/scripts/check_deepseek.py
